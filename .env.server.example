# ISO TCP server and HTTP upstream adapter
MODE=server
PACKAGER_PATH=cfg/packager/iso_spec.xml

# ISO TCP listener. Use a concrete IP if it must not bind all interfaces.
ISO_LISTEN_ADDR=:8989
# Alternative when ISO_LISTEN_ADDR is omitted: ISO_PORT=8989

# Required to process ISO 0200 inquiry/disbursement messages.
# Do not commit credentials or tokens in this file.
MESSAGE_URL=http://simulator:8088/process

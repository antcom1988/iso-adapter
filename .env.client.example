# HTTP-to-ISO TCP client
MODE=client
PACKAGER_PATH=cfg/packager/iso_spec.xml

# HTTP API exposed by this client instance
HTTP_LISTEN_ADDR=:8085

# Remote ISO TCP server (the server instance below)
SERVER_HOST=127.0.0.1
SERVER_PORT=8989

# Go duration (e.g. 60s) or milliseconds
NETWORK_TIMEOUT=60000

# The peer sends 0800/001 and may immediately schedule 0800/301 after TCP accept.
# The client responds 0810/00 to every initial network request before submitting 0200.
INITIAL_NETWORK_HANDSHAKE_TIMEOUT=250ms
